{
  "$schema": "https://opencode.ai/config.json",

  // Rules are ordered. The last match wins, so broad rules come first and
  // exceptions follow.
  "permissions": [
    // Any path in the repo is writable. Who writes what is a workflow rule in
    // AGENTS.md, not a permission gate.
    { "action": "edit", "resource": "*", "effect": "allow" },

    // Employer material stays untouched. These are a hard stop, not a prompt.
    { "action": "edit", "resource": "design/**", "effect": "deny" },
    { "action": "edit", "resource": "docs/brief.md", "effect": "deny" },
    { "action": "edit", "resource": "docs/jd.md", "effect": "deny" },

    // Shell runs freely except where it can destroy work or leave the machine.
    { "action": "shell", "resource": "*", "effect": "allow" },
    { "action": "shell", "resource": "sudo *", "effect": "deny" },
    { "action": "shell", "resource": "npm publish *", "effect": "deny" },
    { "action": "shell", "resource": "rm *", "effect": "ask" },
    { "action": "shell", "resource": "rmdir *", "effect": "ask" },
    { "action": "shell", "resource": "mv *", "effect": "ask" },
    { "action": "shell", "resource": "chmod *", "effect": "ask" },
    { "action": "shell", "resource": "chown *", "effect": "ask" },
    { "action": "shell", "resource": "kill *", "effect": "ask" },
    { "action": "shell", "resource": "git push *", "effect": "ask" },
    { "action": "shell", "resource": "git reset *", "effect": "ask" },
    { "action": "shell", "resource": "git clean *", "effect": "ask" },
    { "action": "shell", "resource": "git rebase *", "effect": "ask" },
    { "action": "shell", "resource": "git checkout *", "effect": "ask" },
    { "action": "shell", "resource": "git switch *", "effect": "ask" },
    { "action": "shell", "resource": "git branch -d *", "effect": "ask" },
    { "action": "shell", "resource": "git branch -D *", "effect": "ask" },
    { "action": "shell", "resource": "git stash drop *", "effect": "ask" },
    { "action": "shell", "resource": "git stash clear *", "effect": "ask" },
    { "action": "shell", "resource": "npx *", "effect": "ask" },
    { "action": "shell", "resource": "npm install -g *", "effect": "ask" },
    { "action": "shell", "resource": "npm i -g *", "effect": "ask" },

    // Narrow denies go last so they win over the broader asks above.
    { "action": "shell", "resource": "git push --force *", "effect": "deny" },
    { "action": "shell", "resource": "git push -f *", "effect": "deny" },
    { "action": "shell", "resource": "git push --force-with-lease *", "effect": "ask" },

    // Anything outside the repo needs a yes, apart from reading the global
    // OpenCode config.
    { "action": "external_directory", "resource": "*", "effect": "ask" },
    { "action": "external_directory", "resource": "~/.config/opencode/*", "effect": "allow" },
    { "action": "read", "resource": "~/.config/opencode/*", "effect": "allow" }
  ]
}
